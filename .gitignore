node_modules/

# Self-contained plugins/themes: per-package node_modules (config-lifecycle /
# self-update model). A plugin/theme that ships its own package.json installs its
# deps here; Node resolves them plugin-local first, falling back to the root.
# Never committed (regenerated by `npm install` inside the folder) and preserved
# across CMS updates (git checkout of a release tag never touches ignored paths).
plugins/*/node_modules/
themes/*/node_modules/

.env

# VSCode editor settings (user-specific, not part of the repo)
.vscode/

# Certificati TLS (mai committare chiavi private)
/certs/

# Auto-generated symlinks (recreated at startup by pluginPagesSystem)
/pluginPages/

# Admin plugin section symlinks (recreated at startup by symlinkManager)
# When adding a new admin plugin, add its sectionId(s) here
/core/admin/webPages/usersManagment
/core/admin/webPages/rolesManagment
/core/admin/webPages/adminAccessControl
/core/admin/webPages/navbarsManagement
/core/admin/webPages/seoManagement
/core/admin/webPages/analyticsManagement
/core/admin/webPages/analyticsSettings
/core/admin/webPages/mediaManagement
/core/admin/webPages/rateLimiterManagement
/core/admin/webPages/csrfManagement
/core/admin/webPages/sentinelManagement

# Auto-generated runtime data
/plugins/urlRedirect/redirectHitCount.json5
/plugins/analytics/data/
/plugins/sentinel/data/
# Decoy personalizzati dall'utente: la cartella resta nel repo (README + .gitkeep),
# il contenuto no. Vedi plugins/sentinel/decoys/README.md.
/plugins/sentinel/decoys/data/*
!/plugins/sentinel/decoys/data/.gitkeep
/plugins/admin/themeInstallLog.json5
/plugins/admin/pluginInstallLog.json5

# Config-lifecycle (docs/decisions/config-lifecycle.it.md): config "vivi"
# materializzati dai rispettivi *.default.json5 al boot (materializeMissingConfigs).
# I .default sono committati (fonte di verità); i vivi NO — sono rigenerabili e
# per-istanza (dati utente inclusi). Il boot scrive isInstalled nei descrittori
# vivi (Fase 2), perciò anch'essi NON sono committati. Restano tracciati solo i
# config core (ital8Config/adminConfig/koaSession), legati al gate di init (Fase 3).
/plugins/seo/seoPages.json5
/plugins/urlRedirect/redirectMap.json5
/plugins/adminAccessControl/accessControl.json5
/plugins/rateLimiter/protectedRoutes.json5
/plugins/sentinel/sentinelRules.json5
/plugins/adminSentinel/backups/
/plugins/adminUsers/userAccount.json5
/plugins/adminUsers/userRole.json5
# Descrittori vivi (plugin + temi): generati dai .default; isInstalled (stato
# runtime) scritto al boot — per i plugin da pluginSys, per i temi bundled da
# ensureThemesInstalled (Fase 5). I .default restano la fonte di verità.
/plugins/*/pluginConfig.json5
/themes/*/themeConfig.json5
# Config core vivi: materializzati dal wizard (npm run start-configure) dai .default.
# Al boot, se ital8Config.json5 manca → gate [INIT] che indirizza al wizard (Fase 3).
/ital8Config.json5
/core/admin/adminConfig.json5
/core/priorityMiddlewares/koaSession.json5

# dbApi: file di database SQLite generati a runtime (plugin opzionale, disattivo di default)
/plugins/dbApi/dbFile/*.db
/plugins/dbApi/dbFile/pluginsDb/*.db

# Public web root (user site content): keep the folder, ignore everything inside.
# Covers site pages and runtime-generated files (e.g. SEO plugin's sitemap.xml / robots.txt).
/www/*
!/www/.gitkeep
# Pagina segnaposto di primo avvio: unico file di /www versionato, così una
# installazione pulita non risponde 404 su `GET /`. È un file normale — chi
# costruisce il proprio sito lo sostituisce, e da quel momento comparirà in
# `git status` come modificato. Vedi il commento in testa al file.
!/www/index.ejs

# Init system
/scripts/initState.json5
/plugins/*/scripts/initState.json5
/logs/
/backups/

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Backup dei config creati dai setup e2e (globalSetup/globalPrefixSetup) e
# ripristinati dal teardown; restano su disco solo se un run crasha prima del
# teardown — non vanno mai committati.
*.test-bak
*.prefix-bak

# Jest coverage output
/coverage/

# CLI control plane unix socket (created at startup, removed on shutdown)
*.sock

# CLI control plane runtime state (public running/stopped), written by cliBridge:
# stato di runtime della singola istanza, non configurazione da versionare.
/core/cliBridge/state.json5
