<%- include( passData.themeSys.getThemePartPath( 'head.ejs', passData ) ) %>
<link rel="stylesheet" href="/<%= passData.adminPrefix %>/sentinelManagement/sentinel-admin.css">
<%- include( passData.themeSys.getThemePartPath( 'header.ejs', passData ) ) %>

<div class="container mt-4 sn-admin">

  <ul class="nav nav-pills mb-3">
    <li class="nav-item"><a class="nav-link active" href="/<%= passData.adminPrefix %>/sentinelManagement/index.ejs"><%= __({it: 'Panoramica', en: 'Overview'}, passData.ctx) %></a></li>
    <li class="nav-item"><a class="nav-link" href="/<%= passData.adminPrefix %>/sentinelManagement/ruleForm.ejs"><%= __({it: 'Regole (form)', en: 'Rules (form)'}, passData.ctx) %></a></li>
    <li class="nav-item"><a class="nav-link" href="/<%= passData.adminPrefix %>/sentinelManagement/rules.ejs"><%= __({it: 'Regole (JSON5)', en: 'Rules (JSON5)'}, passData.ctx) %></a></li>
    <li class="nav-item"><a class="nav-link" href="/<%= passData.adminPrefix %>/sentinelManagement/tester.ejs"><%= __({it: 'Tester', en: 'Tester'}, passData.ctx) %></a></li>
  </ul>

  <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
    <h3 class="mb-0">
      🔭 <%= __({it: 'Sentinel — filtro delle richieste', en: 'Sentinel — request filter'}, passData.ctx) %>
      <span id="modeBadge" class="badge bg-secondary align-middle ms-2">—</span>
    </h3>
    <div class="d-flex align-items-center gap-3">
      <select id="windowDays" class="form-select form-select-sm sn-window">
        <option value="1"><%= __({it: 'Ultime 24 ore', en: 'Last 24 hours'}, passData.ctx) %></option>
        <option value="7" selected><%= __({it: 'Ultimi 7 giorni', en: 'Last 7 days'}, passData.ctx) %></option>
        <option value="30"><%= __({it: 'Ultimi 30 giorni', en: 'Last 30 days'}, passData.ctx) %></option>
        <option value="365"><%= __({it: 'Ultimo anno', en: 'Last year'}, passData.ctx) %></option>
      </select>
      <div class="form-check form-switch mb-0">
        <input class="form-check-input" type="checkbox" role="switch" id="autoRefreshToggle" checked>
        <label class="form-check-label small" for="autoRefreshToggle">
          <%= __({it: 'Auto-aggiornamento', en: 'Auto-refresh'}, passData.ctx) %>
        </label>
      </div>
      <button id="btnToggleMode" class="btn btn-outline-danger btn-sm" disabled>—</button>
      <button id="btnRefresh" class="btn btn-outline-secondary btn-sm">
        <span id="loadingSpinner" class="spinner-border spinner-border-sm d-none" role="status"></span>
        ⟳ <%= __({it: 'Aggiorna', en: 'Refresh'}, passData.ctx) %>
      </button>
    </div>
  </div>

  <div id="globalAlert" class="alert d-none" role="alert"></div>

  <!-- Il service non c'è o è disattivato -->
  <div id="disabledBanner" class="alert alert-warning d-none">
    <%= __({
      it: 'Il plugin sentinel non è attivo. Nessun dato da mostrare.',
      en: 'The sentinel plugin is not active. Nothing to show.'
    }, passData.ctx) %>
  </div>

  <!--
    Osservazione ≠ enforcement. Distinguere le due cose è il punto dell'intera
    interfaccia: `mode: enforce` con il gate su `monitor` NON sta bloccando, e
    mostrare solo il primo dei due sarebbe una trappola diagnostica.
  -->
  <div id="observingBanner" class="alert alert-info d-none">
    <strong><%= __({it: 'Modalità osservazione.', en: 'Observation mode.'}, passData.ctx) %></strong>
    <%= __({
      it: 'Sentinel sta classificando e registrando il traffico, ma non blocca nulla. È il comportamento previsto dopo l\'installazione: guarda i dati qui sotto, e promuovi una regola quando i suoi numeri lo giustificano.',
      en: 'Sentinel is classifying and recording traffic but blocking nothing. This is the expected state after installation: read the data below, and promote a rule when its numbers justify it.'
    }, passData.ctx) %>
  </div>

  <!-- ── KPI ────────────────────────────────────────────────────────────── -->
  <div class="row g-3 mb-3">
    <div class="col-6 col-md-4 col-xl-2">
      <div class="card text-center kpi-card h-100"><div class="card-body py-3">
        <div class="kpi-value" id="kpiTotal">—</div>
        <div class="kpi-label"><%= __({it: 'Classificate', en: 'Classified'}, passData.ctx) %></div>
      </div></div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
      <div class="card text-center kpi-card h-100"><div class="card-body py-3">
        <div class="kpi-value text-danger" id="kpiEnforced">—</div>
        <div class="kpi-label"><%= __({it: 'Applicate', en: 'Enforced'}, passData.ctx) %></div>
      </div></div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
      <div class="card text-center kpi-card h-100"><div class="card-body py-3">
        <div class="kpi-value" id="kpiIps">—</div>
        <div class="kpi-label"><%= __({it: 'IP distinti', en: 'Distinct IPs'}, passData.ctx) %></div>
      </div></div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
      <div class="card text-center kpi-card h-100"><div class="card-body py-3">
        <div class="kpi-value" id="kpiFingerprints">—</div>
        <div class="kpi-label"><%= __({it: 'Impronte', en: 'Fingerprints'}, passData.ctx) %></div>
      </div></div>
    </div>
    <!--
      Il segnale singolo più affidabile: l'UA dichiara un browser ma la forma
      degli header dice client script. Uno dei due mente, e sappiamo quale.
    -->
    <div class="col-6 col-md-4 col-xl-2">
      <div class="card text-center kpi-card h-100 kpi-highlight"><div class="card-body py-3">
        <div class="kpi-value text-warning" id="kpiIncoherent">—</div>
        <div class="kpi-label"><%= __({it: 'UA incoerenti', en: 'UA mismatch'}, passData.ctx) %></div>
      </div></div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
      <div class="card text-center kpi-card h-100"><div class="card-body py-3">
        <div class="kpi-value" id="kpiUnclassified">—</div>
        <div class="kpi-label"><%= __({it: 'Non classificato', en: 'Unclassified'}, passData.ctx) %></div>
      </div></div>
    </div>
  </div>

  <div class="row g-3">

    <!-- ── Composizione del traffico ostile ─────────────────────────────── -->
    <div class="col-12 col-xl-5">
      <div class="card h-100">
        <div class="card-header">
          <%= __({it: 'Composizione per famiglia', en: 'Composition by family'}, passData.ctx) %>
          <div class="small text-muted mt-1">
            <%= __({
              it: 'Non «quante ne ho bloccate», ma di cosa è fatto il traffico che bussa.',
              en: 'Not “how many did I block”, but what the traffic knocking is made of.'
            }, passData.ctx) %>
          </div>
        </div>
        <div class="card-body p-0">
          <table class="table table-sm mb-0 sn-table">
            <tbody id="categoryTable">
              <tr><td class="text-muted p-3"><%= __({it: 'Caricamento…', en: 'Loading…'}, passData.ctx) %></td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- ── Sospetti scanner ─────────────────────────────────────────────── -->
    <div class="col-12 col-xl-7">
      <div class="card h-100">
        <div class="card-header">
          <%= __({it: 'Sospetti scanner', en: 'Suspected scanners'}, passData.ctx) %>
          <div class="small text-muted mt-1">
            <%= __({
              it: 'Client che collezionano molti percorsi distinti falliti. Non derivano da nessuna regola: nascono dall\'osservazione degli esiti, ed è lì che si scoprono gli attacchi per cui una regola ancora non esiste.',
              en: 'Clients collecting many distinct failed paths. These come from no rule: they emerge from outcome observation, which is where you find attacks no rule describes yet.'
            }, passData.ctx) %>
          </div>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-sm mb-0 sn-table">
              <thead><tr>
                <th><%= __({it: 'Client', en: 'Client'}, passData.ctx) %></th>
                <th class="text-end"><%= __({it: 'Path distinti', en: 'Distinct paths'}, passData.ctx) %></th>
                <th class="text-end">404</th>
                <th class="text-end"><%= __({it: 'Totale', en: 'Total'}, passData.ctx) %></th>
                <th><%= __({it: 'Ultimo', en: 'Last seen'}, passData.ctx) %></th>
              </tr></thead>
              <tbody id="scannerTable">
                <tr><td colspan="5" class="text-muted p-3"><%= __({it: 'Caricamento…', en: 'Loading…'}, passData.ctx) %></td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <!-- ── Token esca ────────────────────────────────────────────────────────
      Sta accanto ai sospetti scanner di proposito, perché è il suo opposto
      esatto: là ci sono le inferenze, qui le certezze. Nascosto finché nessun
      token è stato consegnato — una card vuota su una dashboard di sicurezza
      insegna solo a smettere di guardarla.
    -->
    <div class="col-12 col-xl-5 d-none" id="canaryCard">
      <div class="card h-100 border-danger-subtle">
        <div class="card-header">
          🕯️ <%= __({it: 'Token esca (canary)', en: 'Canary tokens'}, passData.ctx) %>
          <div class="small text-muted mt-1">
            <%= __({
              it: 'Un token esiste solo dentro il decoy consegnato a un client preciso: nessun link ci porta e nessuno lo digita per sbaglio. Se torna indietro non è un indizio come tutto il resto di questa pagina — è la certezza di qualcuno che ha letto il decoy e ha deciso di seguirlo.',
              en: 'A token exists only inside the decoy served to one specific client: no link leads there and nobody types it by accident. If it comes back it is not a hint like everything else on this page — it is certainty that someone read the decoy and chose to follow it.'
            }, passData.ctx) %>
          </div>
        </div>
        <div class="card-body">
          <div class="row text-center g-2 mb-3">
            <div class="col-4">
              <div class="kpi-value" id="canaryMinted">—</div>
              <div class="kpi-label"><%= __({it: 'Consegnati', en: 'Delivered'}, passData.ctx) %></div>
            </div>
            <div class="col-4">
              <div class="kpi-value text-danger" id="canaryTriggered">—</div>
              <div class="kpi-label"><%= __({it: 'Usati', en: 'Used'}, passData.ctx) %></div>
            </div>
            <div class="col-4">
              <div class="kpi-value" id="canaryLive">—</div>
              <div class="kpi-label"><%= __({it: 'In registro', en: 'In registry'}, passData.ctx) %></div>
            </div>
          </div>
          <div class="table-responsive">
            <table class="table table-sm mb-0 sn-table">
              <thead><tr>
                <th><%= __({it: 'Quando', en: 'When'}, passData.ctx) %></th>
                <th><%= __({it: 'Usato da', en: 'Used by'}, passData.ctx) %></th>
                <th><%= __({it: 'Consegnato a', en: 'Delivered to'}, passData.ctx) %></th>
                <th><%= __({it: 'Stesso client', en: 'Same client'}, passData.ctx) %></th>
              </tr></thead>
              <tbody id="canaryTable">
                <tr><td colspan="4" class="text-muted p-3"><%= __({it: 'Nessun token ancora usato.', en: 'No token used yet.'}, passData.ctx) %></td></tr>
              </tbody>
            </table>
          </div>
          <div class="small text-muted mt-2">
            <%= __({
              it: '«Stesso client» no significa che il contenuto del decoy è passato di mano: chi scandaglia e chi sfrutta sono due macchine diverse.',
              en: '“Same client” = no means the decoy content changed hands: scanning and exploitation are two different machines.'
            }, passData.ctx) %>
          </div>
        </div>
      </div>
    </div>

    <!-- ── Coerenza di sessione ──────────────────────────────────────────────
      Nascosta finché nessuna sessione autenticata è stata osservata. Sopra un
      sito senza area riservata attiva non ha niente da dire.
    -->
    <div class="col-12 col-xl-7 d-none" id="sessionCard">
      <div class="card h-100">
        <div class="card-header">
          🔐 <%= __({it: 'Coerenza delle sessioni', en: 'Session coherence'}, passData.ctx) %>
          <div class="small text-muted mt-1">
            <%= __({
              it: 'Un cookie rubato funziona: chi lo presenta È l\'utente, per il server. Ma il ladro non eredita il client — la sessione era nata su un browser e a un certo punto arriva da uno script. La linea di base è come la sessione appariva alla prima richiesta, e non viene mai aggiornata.',
              en: 'A stolen cookie works: whoever presents it IS the user, as far as the server knows. But the thief does not inherit the client — the session started on a browser and at some point arrives from a script. The baseline is how the session looked on its first request, and is never updated.'
            }, passData.ctx) %>
          </div>
        </div>
        <div class="card-body">
          <div class="row text-center g-2 mb-3">
            <div class="col-4">
              <div class="kpi-value" id="sessTracked">—</div>
              <div class="kpi-label"><%= __({it: 'Sessioni viste', en: 'Sessions seen'}, passData.ctx) %></div>
            </div>
            <div class="col-4">
              <div class="kpi-value text-warning" id="sessFlagged">—</div>
              <div class="kpi-label"><%= __({it: 'Con anomalie', en: 'With anomalies'}, passData.ctx) %></div>
            </div>
            <div class="col-4">
              <div class="kpi-value" id="sessLive">—</div>
              <div class="kpi-label"><%= __({it: 'Attive', en: 'Live'}, passData.ctx) %></div>
            </div>
          </div>
          <div class="table-responsive">
            <table class="table table-sm mb-0 sn-table">
              <thead><tr>
                <th><%= __({it: 'Quando', en: 'When'}, passData.ctx) %></th>
                <th><%= __({it: 'Account', en: 'Account'}, passData.ctx) %></th>
                <th><%= __({it: 'Anomalia', en: 'Anomaly'}, passData.ctx) %></th>
                <th><%= __({it: 'Da → a', en: 'From → to'}, passData.ctx) %></th>
              </tr></thead>
              <tbody id="sessionTable">
                <tr><td colspan="4" class="text-muted p-3"><%= __({it: 'Nessuna anomalia rilevata.', en: 'No anomaly detected.'}, passData.ctx) %></td></tr>
              </tbody>
            </table>
          </div>
          <div class="small text-muted mt-2">
            <%= __({
              it: 'Lo stato è in memoria: dopo un riavvio le linee di base ripartono da come il client appare in quel momento. È un sensore in più, non l\'unico presidio sulle sessioni.',
              en: 'State lives in memory: after a restart, baselines start again from how the client looks at that moment. This is one more sensor, not the only safeguard on sessions.'
            }, passData.ctx) %>
          </div>
        </div>
      </div>
    </div>

    <!-- ── Stato delle regole: il cuore della promozione ─────────────────── -->
    <div class="col-12">
      <div class="card">
        <div class="card-header">
          <%= __({it: 'Regole', en: 'Rules'}, passData.ctx) %>
          <div class="small text-muted mt-1">
            <%= __({
              it: 'La colonna «Utenti autenticati» è il semaforo: se è zero dopo settimane di traffico, promuovere la regola a blocco è sicuro. Se è diversa da zero c\'è un falso positivo non ancora capito.',
              en: 'The “Authenticated users” column is the traffic light: zero after weeks of real traffic means promoting the rule to block is safe. Anything else means a false positive you have not understood yet.'
            }, passData.ctx) %>
          </div>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-sm table-hover mb-0 sn-table">
              <thead><tr>
                <th><%= __({it: 'Regola', en: 'Rule'}, passData.ctx) %></th>
                <th class="text-end"><%= __({it: 'Scatti', en: 'Hits'}, passData.ctx) %></th>
                <th class="text-end"><%= __({it: 'Applicati', en: 'Enforced'}, passData.ctx) %></th>
                <th class="text-end"><%= __({it: 'IP distinti', en: 'Distinct IPs'}, passData.ctx) %></th>
                <th class="text-end"><%= __({it: 'Bot', en: 'Bots'}, passData.ctx) %></th>
                <th class="text-end"><%= __({it: 'Utenti autenticati', en: 'Authenticated users'}, passData.ctx) %></th>
                <th><%= __({it: 'Promuovibile', en: 'Promotable'}, passData.ctx) %></th>
                <th><%= __({it: 'Azione', en: 'Action'}, passData.ctx) %></th>
              </tr></thead>
              <tbody id="ruleTable">
                <tr><td colspan="8" class="text-muted p-3"><%= __({it: 'Caricamento…', en: 'Loading…'}, passData.ctx) %></td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <!-- ── Impronte ─────────────────────────────────────────────────────── -->
    <div class="col-12 col-xl-6">
      <div class="card h-100">
        <div class="card-header">
          <%= __({it: 'Impronte HTTP', en: 'HTTP fingerprints'}, passData.ctx) %>
          <span id="ipModeBadge" class="badge bg-light text-dark ms-2">—</span>
          <div class="small text-muted mt-1">
            <%= __({
              it: 'Una impronta vista da molti IP distinti è una botnet — e lo si sa senza conservare un solo indirizzo.',
              en: 'One fingerprint seen from many distinct IPs is a botnet — and you know it without storing a single address.'
            }, passData.ctx) %>
          </div>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-sm mb-0 sn-table">
              <thead><tr>
                <th><%= __({it: 'Impronta', en: 'Fingerprint'}, passData.ctx) %></th>
                <th><%= __({it: 'Famiglia', en: 'Family'}, passData.ctx) %></th>
                <th class="text-end"><%= __({it: 'Richieste', en: 'Requests'}, passData.ctx) %></th>
                <th class="text-end">IP</th>
                <th><%= __({it: 'Coerente', en: 'Coherent'}, passData.ctx) %></th>
              </tr></thead>
              <tbody id="fingerprintTable">
                <tr><td colspan="5" class="text-muted p-3"><%= __({it: 'Caricamento…', en: 'Loading…'}, passData.ctx) %></td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <!-- ── Eventi recenti ───────────────────────────────────────────────── -->
    <div class="col-12 col-xl-6">
      <div class="card h-100">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
          <span><%= __({it: 'Eventi recenti', en: 'Recent events'}, passData.ctx) %></span>
          <div class="form-check form-switch mb-0">
            <input class="form-check-input" type="checkbox" role="switch" id="enforcedOnlyToggle">
            <label class="form-check-label small" for="enforcedOnlyToggle">
              <%= __({it: 'Solo applicati', en: 'Enforced only'}, passData.ctx) %>
            </label>
          </div>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive sn-events">
            <table class="table table-sm mb-0 sn-table">
              <thead><tr>
                <th><%= __({it: 'Quando', en: 'When'}, passData.ctx) %></th>
                <th><%= __({it: 'Percorso', en: 'Path'}, passData.ctx) %></th>
                <th><%= __({it: 'Regola', en: 'Rule'}, passData.ctx) %></th>
                <th>IP</th>
                <th><%= __({it: 'Esito', en: 'Outcome'}, passData.ctx) %></th>
              </tr></thead>
              <tbody id="eventTable">
                <tr><td colspan="5" class="text-muted p-3"><%= __({it: 'Caricamento…', en: 'Loading…'}, passData.ctx) %></td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

  </div>

  <!--
    Un tasso di sfratto che sale non è una statistica di servizio: in esercizio
    normale resta a zero, perché il traffico vero converge su poche decine di
    impronte. Se sale, qualcuno sta producendo chiavi a raffica per gonfiare gli
    archivi — la contromisura si comporta da rilevatore.
  -->
  <!-- ── Tarpit al tetto ───────────────────────────────────────────────────
    Compare solo quando il tetto sta rifiutando. È l'unico dato del tarpit che
    richiede una decisione: significa che qualcuno ha superato la capienza che
    hai deciso, e da quel momento le richieste in più ricevono il 404 comune.
  -->
  <div id="tarpitWarning" class="alert alert-warning mt-3 d-none">
    <strong><%= __({it: 'Il tetto delle connessioni trattenute è stato raggiunto.', en: 'The tarpit capacity limit has been reached.'}, passData.ctx) %></strong>
    <span id="tarpitDetail"></span>
    <%= __({
      it: 'Oltre il tetto le richieste degradano al 404 comune invece di essere trattenute — comportamento voluto, perché accodarle sposterebbe il consumo di risorse invece di fermarlo. Se succede spesso, alza `tarpit.maxConcurrent` solo se la macchina regge i socket in più.',
      en: 'Beyond the limit, requests degrade to the ordinary 404 instead of being held — intended behaviour, since queueing them would move the resource cost rather than stop it. If this happens often, raise `tarpit.maxConcurrent` only if the machine can take the extra sockets.'
    }, passData.ctx) %>
  </div>

  <div id="evictionWarning" class="alert alert-warning mt-3 d-none">
    <strong><%= __({it: 'Sfratti in corso negli archivi.', en: 'Evictions happening in the aggregates.'}, passData.ctx) %></strong>
    <span id="evictionDetail"></span>
    <%= __({
      it: 'In esercizio normale questo valore resta a zero: un valore che sale indica che qualcuno sta generando impronte o client nuovi a raffica.',
      en: 'In normal operation this stays at zero: a rising value means someone is generating new fingerprints or clients in bulk.'
    }, passData.ctx) %>
  </div>

  <p class="text-muted small mt-3 mb-0">
    <%= __({it: 'Sorgente dati:', en: 'Data source:'}, passData.ctx) %>
    <code id="dataDir">—</code>
    <%#
      Il riepilogo può arrivare da un calcolo di qualche secondo fa: dirlo è la
      stessa cura per cui la pagina forza il salvataggio degli archivi prima di
      leggerli. Un numero vecchio va benissimo, un numero vecchio spacciato per
      istantaneo no.
    %>
    · <%= __({it: 'riepilogo calcolato:', en: 'summary computed:'}, passData.ctx) %>
    <span id="summaryComputedAt">—</span>
  </p>

</div>

<script>
  const SN_API = '/<%= passData.apiPrefix %>/adminSentinel';
  const SN_AUTO_REFRESH_SECONDS = <%= passData.plugin.adminSentinel.autoRefreshSeconds %>;
  const SN_EVENT_LIMIT = <%= passData.plugin.adminSentinel.eventLimit %>;
  const SN_DEFAULT_DAYS = <%= passData.plugin.adminSentinel.windowDays %>;
</script>
<script src="/<%= passData.adminPrefix %>/sentinelManagement/sentinel-admin.js"></script>

<%- include( passData.themeSys.getThemePartPath( 'footer.ejs', passData ) ) %>
