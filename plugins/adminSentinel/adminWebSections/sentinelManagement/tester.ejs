<%- include( passData.themeSys.getThemePartPath( 'head.ejs', passData ) ) %>
<link rel="stylesheet" href="/<%= passData.adminPrefix %>/sentinelManagement/sentinel-admin.css">
<%- include( passData.themeSys.getThemePartPath( 'header.ejs', passData ) ) %>

<div class="container mt-4 sn-admin">

  <ul class="nav nav-pills mb-3">
    <li class="nav-item"><a class="nav-link" href="/<%= passData.adminPrefix %>/sentinelManagement/index.ejs"><%= __({it: 'Panoramica', en: 'Overview'}, passData.ctx) %></a></li>
    <li class="nav-item"><a class="nav-link" href="/<%= passData.adminPrefix %>/sentinelManagement/ruleForm.ejs"><%= __({it: 'Regole (form)', en: 'Rules (form)'}, passData.ctx) %></a></li>
    <li class="nav-item"><a class="nav-link" href="/<%= passData.adminPrefix %>/sentinelManagement/rules.ejs"><%= __({it: 'Regole (JSON5)', en: 'Rules (JSON5)'}, passData.ctx) %></a></li>
    <li class="nav-item"><a class="nav-link active" href="/<%= passData.adminPrefix %>/sentinelManagement/tester.ejs"><%= __({it: 'Tester', en: 'Tester'}, passData.ctx) %></a></li>
  </ul>

  <h3 class="mb-3">🧪 <%= __({it: 'Prova una richiesta', en: 'Try a request'}, passData.ctx) %></h3>

  <div class="alert alert-secondary small">
    <%= __({
      it: 'Serve soprattutto a rispondere alla domanda opposta a quella che sembra: non «quale regola scatta» — quello si vede dal log — ma «ho scritto questa regola e non scatta, perché?». Per ogni condizione trovi atteso e osservato.',
      en: 'This mostly answers the opposite question to the obvious one: not “which rule fires” — the log shows that — but “I wrote this rule and it does not fire, why?”. Each condition shows expected vs observed.'
    }, passData.ctx) %>
  </div>

  <div class="row g-3">
    <div class="col-12 col-xl-4">
      <div class="card">
        <div class="card-body">
          <div class="mb-2">
            <label class="form-label small mb-1"><%= __({it: 'Percorso', en: 'Path'}, passData.ctx) %></label>
            <input id="tPath" class="form-control form-control-sm" value="/wp-login.php" spellcheck="false">
          </div>
          <div class="row g-2 mb-2">
            <div class="col-6">
              <label class="form-label small mb-1"><%= __({it: 'Metodo', en: 'Method'}, passData.ctx) %></label>
              <select id="tMethod" class="form-select form-select-sm">
                <option>GET</option><option>POST</option><option>PUT</option>
                <option>DELETE</option><option>HEAD</option><option>PROPFIND</option><option>TRACE</option>
              </select>
            </div>
            <div class="col-6">
              <label class="form-label small mb-1">IP</label>
              <input id="tIp" class="form-control form-control-sm" value="203.0.113.44" spellcheck="false">
            </div>
          </div>
          <div class="mb-2">
            <label class="form-label small mb-1">User-Agent</label>
            <input id="tUa" class="form-control form-control-sm" value="curl/8.5.0" spellcheck="false">
          </div>
          <div class="mb-2">
            <label class="form-label small mb-1"><%= __({it: 'Query string', en: 'Query string'}, passData.ctx) %></label>
            <input id="tQuery" class="form-control form-control-sm" placeholder="q=1&x=2" spellcheck="false">
          </div>
          <div class="form-check form-switch mb-2">
            <input class="form-check-input" type="checkbox" id="tBrowser">
            <label class="form-check-label small" for="tBrowser">
              <%= __({it: 'Simula un browser reale', en: 'Simulate a real browser'}, passData.ctx) %>
              <span class="text-muted d-block" style="font-size:.75rem">
                <%= __({
                  it: 'aggiunge Accept, Sec-Fetch-*, sec-ch-ua… Senza, ogni prova sembra un client script.',
                  en: 'adds Accept, Sec-Fetch-*, sec-ch-ua… Without it every trial looks like a script client.'
                }, passData.ctx) %>
              </span>
            </label>
          </div>
          <div class="form-check form-switch mb-2">
            <input class="form-check-input" type="checkbox" id="tAuth">
            <label class="form-check-label small" for="tAuth"><%= __({it: 'Richiesta autenticata', en: 'Authenticated request'}, passData.ctx) %></label>
          </div>
          <div class="mb-3">
            <label class="form-label small mb-1"><%= __({it: 'Ruoli (separati da virgola)', en: 'Roles (comma separated)'}, passData.ctx) %></label>
            <input id="tRoles" class="form-control form-control-sm" placeholder="1" spellcheck="false">
          </div>
          <div class="mb-3">
            <label class="form-label small mb-1">
              <%= __({it: 'Anomalie di sessione da simulare', en: 'Session anomalies to simulate'}, passData.ctx) %>
            </label>
            <select id="tSessionAnomaly" class="form-select form-select-sm" multiple size="5">
              <option value="uaChanged">uaChanged</option>
              <option value="fingerprintChanged">fingerprintChanged</option>
              <option value="networkChanged">networkChanged</option>
              <option value="ipChanged">ipChanged</option>
              <option value="scriptClient">scriptClient</option>
            </select>
            <div class="form-text small">
              <%= __({
                it: 'Si dichiarano, non si calcolano: la domanda è «se questa sessione avesse cambiato client, la mia regola la prenderebbe?». Valgono solo con «Richiesta autenticata» attiva.',
                en: 'These are declared, not computed: the question is “if this session had changed client, would my rule catch it?”. They only apply with “Authenticated request” on.'
              }, passData.ctx) %>
            </div>
          </div>
          <div class="form-check form-switch mb-3">
            <input class="form-check-input" type="checkbox" id="tVerbose" checked>
            <label class="form-check-label small" for="tVerbose"><%= __({it: 'Mostra anche le regole che NON matchano', en: 'Show rules that do NOT match too'}, passData.ctx) %></label>
          </div>
          <button id="btnTest" class="btn btn-primary btn-sm w-100">▶ <%= __({it: 'Prova', en: 'Run'}, passData.ctx) %></button>
        </div>
      </div>
    </div>

    <div class="col-12 col-xl-8">
      <div id="testAlert" class="alert d-none" role="alert"></div>
      <div class="card">
        <div class="card-header"><%= __({it: 'Esito', en: 'Result'}, passData.ctx) %></div>
        <div class="card-body">
          <div id="testResult" class="text-muted small"><%= __({it: 'Compila il modulo e premi Prova.', en: 'Fill the form and press Run.'}, passData.ctx) %></div>
        </div>
      </div>
    </div>
  </div>

</div>

<script>
  const SN_API = '/<%= passData.apiPrefix %>/adminSentinel';

  <%# Etichette per il JS di pagina — vedi la nota in index.ejs. %>
  const SN_I18N = <%- JSON.stringify({
    absent:       __({it: '(assente)', en: '(absent)'}, passData.ctx),
    blank:        __({it: '(vuoto)', en: '(blank)'}, passData.ctx),
    none:         __({it: 'nessuna', en: 'none'}, passData.ctx),
    yes:          __({it: 'sì', en: 'yes'}, passData.ctx),
    no:           __({it: 'no', en: 'no'}, passData.ctx),
    expected:     __({it: 'atteso', en: 'expected'}, passData.ctx),
    observed:     __({it: 'osservato', en: 'observed'}, passData.ctx),
    subjectLine:  __({
      it: 'ip: {ip} · estensione: {ext} · impronta: ',
      en: 'ip: {ip} · extension: {ext} · fingerprint: '
    }, passData.ctx),
    familyLine:   __({it: ' · famiglia: {family} · profilo: {profile} · coerente: ', en: ' · family: {family} · profile: {profile} · coherent: '}, passData.ctx),
    matched:      __({it: ' → action: ', en: ' → action: '}, passData.ctx),
    categoryNote: __({it: '(categoria: {category})', en: '(category: {category})'}, passData.ctx),
    noMatch:      __({
      it: '✗ Nessuna regola matcha: la richiesta passerebbe senza essere classificata.',
      en: '✗ No rule matches: the request would pass without being classified.'
    }, passData.ctx),
    skipped:      __({it: 'saltata: {reason}', en: 'skipped: {reason}'}, passData.ctx),
    afterWinner:  __({it: 'dopo la vincitrice', en: 'after the winner'}, passData.ctx),
    verboseHint:  __({
      it: 'Attiva «mostra anche le regole che non matchano» per vedere perché ciascuna è stata scartata.',
      en: 'Turn on “also show rules that do not match” to see why each was discarded.'
    }, passData.ctx),
    pathRequired: __({it: 'Il percorso è obbligatorio.', en: 'The path is required.'}, passData.ctx),
    unavailable:  __({it: 'Il filtro non è disponibile.', en: 'The filter is not available.'}, passData.ctx),
    networkError: __({it: 'Errore di rete: {error}', en: 'Network error: {error}'}, passData.ctx),
  }).replace(/</g, '\\u003c') %>;
</script>
<%# La funzione delle etichette, condivisa: va caricata PRIMA dello script di pagina. %>
<script src="/<%= passData.adminPrefix %>/sentinelManagement/sentinel-i18n.js"></script>
<script src="/<%= passData.adminPrefix %>/sentinelManagement/tester.js"></script>

<%- include( passData.themeSys.getThemePartPath( 'footer.ejs', passData ) ) %>
