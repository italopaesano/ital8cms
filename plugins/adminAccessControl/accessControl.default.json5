// This file follows the JSON5 standard - comments and trailing commas are supported
{
  "schemaVersion": 3,  // Versione della STRUTTURA del file (incrementare quando cambiano le chiavi). Vedi docs/decisions/config-lifecycle.it.md
  "version": "1.0.0",
  "lastModified": "2026-01-28T10:00:00Z",

  // ==========================================================================
  // REGOLE HARDCODED — DOCUMENTAZIONE, NON PIU' LA FONTE DI VERITA'
  // ==========================================================================
  // Queste regole restano qui perche' sono LEGGIBILI: dicono a chi apre il file
  // qual e' il minimo d'accesso del pannello. Ma la protezione del pannello NON
  // dipende piu' da loro.
  //
  // PERCHE' E' CAMBIATO. Fin qui la protezione era scritta come TESTO (`/admin`),
  // mentre la posizione reale del pannello e' una VARIABILE
  // (`ital8Config.json5 -> adminPrefix`). Nessun codice sincronizzava le due cose:
  // bastava cambiare `adminPrefix` in `backoffice` perche' nessuna regola matchasse
  // piu', e allora si applicava la `defaultPolicy` — che di serie e' `allow`. Le
  // pagine admin finivano servite a un anonimo, e chi aveva cambiato il prefisso lo
  // aveva fatto CREDENDO di aumentare la sicurezza. (REVIEW.md -> A1)
  //
  // COSA PROTEGGE IL PANNELLO ADESSO. Ogni zona dello spazio URL porta il proprio
  // minimo d'accesso — il suo `baseline` — scritto IN CODICE, in
  // `core/pathZoneResolver.js`. La zona `admin` ha `baseline` chiuso ai ruoli
  // [0, 1] qualunque sia il prefisso configurato. Conseguenza da conoscere: se
  // questo file viene svuotato, corrotto o cancellato, il pannello resta
  // PROTETTO (prima, in tutti e tre i casi, si apriva a chiunque).
  //
  // COSA PUO' FARE UNA REGOLA. Solo STRINGERE il `baseline` della sua zona, mai
  // allentarlo. Una regola che negasse l'autenticazione in zona `admin`, o che
  // concedesse un ruolo che il `baseline` non ammette, viene segnalata al
  // caricamento e il `baseline` vince comunque.
  //
  // Il campo "editable: false" continua a impedire la modifica via interfaccia
  // admin, e la validazione continua a rifiutare qualsiasi modifica di questa
  // sezione dalla UI.
  //
  // -> docs/decisions/path-zones.it.md
  // ==========================================================================
  "hardcodedRules": {
    "/admin": {
      "requiresAuth": true,
      "allowedRoles": [0, 1], // root (0), admin (1)
      "priority": 1000, // Higher priority than /admin/** (exact match wins)
      "editable": false
    },
    "/admin/**": {
      "requiresAuth": true,
      "allowedRoles": [0, 1], // root (0), admin (1)
      "priority": 100,
      "editable": false
    }
  },

  // ==========================================================================
  // REGOLE CUSTOM (modificabili via UI admin)
  // ==========================================================================
  // Queste regole possono essere aggiunte, modificate ed eliminate tramite
  // l'interfaccia admin in /admin/adminAccessControl/
  //
  // Pattern supportati:
  //   - Match esatto: "/dashboard.ejs"
  //   - Wildcard singolo: "/content/*.ejs" (non ricorsivo)
  //   - Wildcard ricorsivo: "/content/**" (tutti i livelli)
  //   - Regex: "regex:/api/user/\\d+" (prefisso "regex:" obbligatorio)
  //
  // Priorità automatica (da alta a bassa):
  //   1. Match esatto (es: /dashboard.ejs)
  //   2. Regex (es: regex:/api/user/\\d+)
  //   3. Wildcard singolo (es: /content/*.ejs)
  //   4. Wildcard ricorsivo (es: /admin/**)
  //
  // In caso di conflitto, la regola più specifica vince.
  // ==========================================================================
  "customRules": {
    // Pagina profilo utente: accessibile solo a utenti autenticati (qualsiasi ruolo)
    "/pluginPages/adminUsers/userProfile.ejs": {
      "requiresAuth": true,
      "allowedRoles": [] // Tutti gli utenti autenticati
    },
    "/pluginPages/adminUsers/userProfile": {
      "requiresAuth": true,
      "allowedRoles": [] // idem, forma senza estensione (hideExtension attivo)
    },

    // ── Varchi di autenticazione: pagine PUBBLICHE che appartengono comunque
    //    alla superficie riservata ──────────────────────────────────────────
    //
    // isAuthEntryPoint non incide sul controllo accessi ordinario: serve solo al
    // comando `npm run cli -- reserved stop`, che chiude tutto cio che sta dietro
    // l'autenticazione. Senza il marcatore queste pagine resterebbero servite
    // anche a superficie chiusa, annunciando l'esistenza dell'area riservata —
    // esattamente cio che l'assetto vetrina vuole evitare.
    //
    // PERCHE' OGNI PAGINA HA DUE REGOLE: con `hideExtension.pluginPagesPrefix`
    // attivo l'URL servito e senza estensione (`.../login`), e una regola su
    // `login.ejs` non lo intercetterebbe.
    //
    // Le due forme sono scritte come match ESATTI, non come wildcard `login*`:
    // il wildcard singolo di patternMatcher traduce `*` in `[^/]+` — UNO O PIU'
    // caratteri — quindi `login*` copre `login.ejs` ma NON `login`, cioe
    // proprio la forma che doveva coprire (verificato). In piu' catturerebbe
    // per sbaglio pagine vicine come `loginHelper.ejs`. Il match esatto e anche
    // quello a priorita' massima.
    // Vedi docs/cli-control-plane.it.md → "Superficie riservata".

    // Pagina di login (deve essere pubblica, o nessuno potrebbe autenticarsi)
    "/pluginPages/adminUsers/login.ejs": {
      "requiresAuth": false,
      "allowedRoles": [],
      "isAuthEntryPoint": true
    },
    "/pluginPages/adminUsers/login": {
      "requiresAuth": false,
      "allowedRoles": [],
      "isAuthEntryPoint": true
    },

    // Pagina di logout: varco in uscita, stessa logica
    "/pluginPages/adminUsers/logout.ejs": {
      "requiresAuth": false,
      "allowedRoles": [],
      "isAuthEntryPoint": true
    },
    "/pluginPages/adminUsers/logout": {
      "requiresAuth": false,
      "allowedRoles": [],
      "isAuthEntryPoint": true
    },

    // Pagina "accesso negato": non richiede autenticazione, ma la sua sola
    // esistenza annuncia che esiste un sistema di controllo accessi
    "/pluginPages/adminAccessControl/access-denied.ejs": {
      "requiresAuth": false,
      "allowedRoles": [],
      "isAuthEntryPoint": true
    },
    "/pluginPages/adminAccessControl/access-denied": {
      "requiresAuth": false,
      "allowedRoles": [],
      "isAuthEntryPoint": true
    }
  },

  // ==========================================================================
  // DEFAULT POLICY
  // ==========================================================================
  // Comportamento quando nessuna regola matcha l'URL richiesto.
  //
  // action:
  //   - "allow": Accesso pubblico (default)
  //   - "deny": Accesso negato (403 Forbidden)
  //   - "requireAuth": Solo utenti autenticati
  //
  // redirectOnDenied: URL di redirect quando l'accesso è negato
  // ==========================================================================
  "defaultPolicy": {
    "action": "allow", // "allow" | "deny" | "requireAuth"
    "redirectOnDenied": "/pluginPages/adminUsers/login.ejs"
  }
}
