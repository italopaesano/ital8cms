// This file follows the JSON5 standard - comments and trailing commas are supported
{
  "schemaVersion": 4,  // Versione della STRUTTURA del file (incrementare quando cambiano le chiavi). Vedi docs/decisions/config-lifecycle.it.md
  //
  // È anche il CLOCK delle migrazioni del pacchetto: v4 porta i pattern di
  // accessControl ai segnaposti di percorso. Vedi migrations/migrations.json5.
  "active": 1,
  "weight": -5, // Peso negativo per caricare PRIMA degli altri plugin (il middleware deve intercettare prima)

  // Dipendenze plugin
  "dependency": {
    "adminUsers": "^1.0.0" // Dipende da adminUsers per autenticazione e sistema ruoli
  },

  // Dipendenze Node modules
  "nodeModuleDependency": {
    "ejs": ">=3.1.9"
  },

  // Sezioni admin gestite da questo plugin
  "adminSections": [
    "adminAccessControl"
  ],

  "custom": {}
}
