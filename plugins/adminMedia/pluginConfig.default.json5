// This file follows the JSON5 standard - comments and trailing commas are supported
{
  "schemaVersion": 2,  // Versione della STRUTTURA del file (incrementare quando cambiano le chiavi). Vedi docs/decisions/config-lifecycle.it.md
  "active": 1,
  "weight": 0,

  // ℹ️ CONVENZIONE: Plugin con nome che inizia per "admin" sono automaticamente plugin admin
  // Array di ID delle sezioni admin gestite da questo plugin
  "adminSections": [
    "mediaManagement"
  ],

  "dependency": {
    "bootstrap": "^1.0.0",
    // Twin of the `media` service: adminMedia reads the media dir + variant
    // schema from media's shared object and writes variants accordingly.
    "media": "^1.1.0",
  },
  // Self-contained plugin (per-plugin node_modules model): the npm dependencies
  // are declared in this plugin's own package.json — @koa/multer + multer as
  // `dependencies`, sharp as an `optionalDependencies` (image optimization stays
  // optional: the file manager keeps working without it, required defensively in
  // lib/variantGenerator.js). They install into plugins/adminMedia/node_modules
  // via `npm install` inside this folder; Node resolves them plugin-local first.
  // nodeModuleDependency is intentionally EMPTY: the root-model boot gate must
  // not check deps that live plugin-local. See docs/decisions/config-lifecycle.it.md
  "nodeModuleDependency": {},
  "custom": {
    // NOTE: `mediaDir` is owned by the `media` service plugin (single source of
    // truth). adminMedia reads it from media — do not duplicate it here.

    // Limiti dimensione file per categoria (in bytes)
    "fileSizeLimits": {
      "image": 10485760,   // 10 MB
      "video": 524288000,  // 500 MB
      "audio": 52428800,   // 50 MB
    },

    // Numero di file per pagina nella UI (griglia e lista)
    "itemsPerPage": 50,
  },
  "version": "1.0.0"
}
